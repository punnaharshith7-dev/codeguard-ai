# Copy to .env for Docker Compose. Keep secrets out of source control.
POSTGRES_DB=codeguard
POSTGRES_USER=codeguard
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://codeguard:replace-with-a-long-random-password@db:5432/codeguard
SECRET_KEY=replace-with-at-least-32-random-bytes
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
COOKIE_SECURE=false
# Optional GitHub OAuth App for sign-in (separate from the GitHub App below).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-bytes
AUTH_BRIDGE_SECRET=replace-with-the-same-long-random-secret-as-frontend
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
MAX_UPLOAD_BYTES=2097152
# Optional server-side LLM provider. Keys stay on the backend; Ollama is local.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=45
AGENT_MAX_OUTPUT_TOKENS=4096
# Optional separate GitHub App for pull-request scanning.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

